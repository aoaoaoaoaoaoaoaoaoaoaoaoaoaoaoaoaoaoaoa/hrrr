#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
out=${1:-/tmp/hrrr-playtest}
skill=${X11_GUI_TEST_SKILL:-$(readlink -f "${CODEX_HOME:-$HOME/.codex}/skills/x11-gui-testing")}
archive=${HRRR_BASEMAP_ARCHIVE:-${XDG_DATA_HOME:-$HOME/.local/share}/hrrr/basemap/basemap.pmtiles}
binary=${HRRR_PLAYTEST_BINARY:-}
xdg=$out/xdg-$$

mkdir -p "$out"
if [ -z "$binary" ]; then
    target=$(cargo metadata --manifest-path "$root/Cargo.toml" --format-version 1 --no-deps \
        | sed -n 's/.*"target_directory":"\([^"]*\)".*/\1/p')
    cargo build --manifest-path "$root/Cargo.toml"
    binary=$target/debug/hrrr
fi
test -x "$binary"
test -s "$archive"
archive=$(readlink -f "$archive")
export HRRR_BASEMAP_ARCHIVE=$archive

"$skill/scripts/isolated-x11" \
    --wgpu \
    --screen 1440x920x24 \
    --xdg-root "$xdg" \
    -- sh -eu -c '
    binary=$1
    out=$2
    leader=
    window=

    stop() {
        if [ -n "$leader" ]; then
            kill -- "-$leader" 2>/dev/null || true
            wait "$leader" 2>/dev/null || true
            leader=
        fi
    }
    trap stop EXIT HUP INT TERM

    start() {
        log=$1
        setsid "$binary" >"$log" 2>&1 &
        leader=$!
        window=$(timeout 20 xdotool search --sync --onlyvisible --pid "$leader" \
            --name "^HRRR · native forecast fields$" | sed -n "1p")
        xdotool windowmap --sync "$window"
        xdotool windowfocus --sync "$window"
    }

    await_file() {
        timeout 10 sh -c '"'"'until test -s "$1"; do sleep 0.05; done'"'"' sh "$1"
    }

    mkdir -p "$XDG_CONFIG_HOME/hrrr"
    printf "close_minimizes = false\n" >"$XDG_CONFIG_HOME/hrrr/config.toml"
    start "$out/app.log"
    sleep 4
    import -window "$window" "$out/startup.png"

    xdotool mousemove --window "$window" 140 96 click 1
    await_file "$XDG_STATE_HOME/hrrr/slate.toml"
    timeout 10 sh -c '"'"'until rg -q "^overlay = \"none\"$" "$1"; do sleep 0.05; done'"'"' \
        sh "$XDG_STATE_HOME/hrrr/slate.toml"
    import -window "$window" "$out/basemap-only.png"

    xdotool mousemove --window "$window" 140 96 click 1
    xdotool keydown shift
    xdotool mousemove --window "$window" 900 520 click 1
    xdotool keyup shift
    await_file "$XDG_DATA_HOME/hrrr/views.toml"
    timeout 10 sh -c '"'"'until rg -q "^pins = \\[\\[" "$1"; do sleep 0.05; done'"'"' \
        sh "$XDG_DATA_HOME/hrrr/views.toml"
    xdotool mousemove --window "$window" 900 520 click --repeat 6 4
    sleep 1
    import -window "$window" "$out/probe-and-zoom.png"

    stop

    start "$out/restart.log"
    sleep 3
    import -window "$window" "$out/restarted.png"
    stop

    for image in startup basemap-only probe-and-zoom restarted; do
        test -s "$out/$image.png"
    done
    for log in "$out/app.log" "$out/restart.log"; do
        if rg -i "panicked|validation error|surface texture validation failure|fatal" "$log"; then
            exit 1
        fi
    done
' sh "$binary" "$out"

"$skill/scripts/isolated-x11" \
    --wgpu \
    --screen 1440x920x24 \
    --xdg-root "$out/tray-xdg-$$" \
    -- "$root/scripts/tray-playtest" \
    "$binary" \
    "$out" \
    "$root/scripts/i3-playtest.config"
